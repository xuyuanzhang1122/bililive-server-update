[Unit]
Description=bililive server update and backup service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bililive
Group=bililive
WorkingDirectory=/opt/bililive-server-update
ExecStart=/opt/bililive-server-update/bililive-server-update
Restart=on-failure
RestartSec=3

Environment=BLSU_ADDR=127.0.0.1:8090
Environment=BLSU_DATA_DIR=/var/lib/bililive-server-update
Environment=BLSU_PUBLIC_BASE_URL=https://update.example.com
Environment=BLSU_GITHUB_REPO=xuyuanzhang1122/bililive-go-UI
Environment=BLSU_ADMIN_TOKEN=change-me

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/bililive-server-update

[Install]
WantedBy=multi-user.target

